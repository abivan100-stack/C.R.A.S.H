# --- secrets ---------------------------------------------------------------
# Never commit the MongoDB URI or the Anthropic API key — they live only in
# backend/.env locally, and in Render's environment settings in production.
.env
.env.local
.env.*.local

# --- python ----------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# --- tooling caches --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- node ------------------------------------------------------------------
node_modules/

# --- logs ------------------------------------------------------------------
*.log
server.log

# --- OS junk ---------------------------------------------------------------
.DS_Store
Thumbs.db

# --- road-snapping (offline generation) ------------------------------------
# The snapped accidents.json + citizen_seed.json ARE committed; the OSM graph
# and the HTTP cache are large and regenerable, so they stay out of git.
scripts/chennai_drive.graphml
scripts/cache/
.vercel
